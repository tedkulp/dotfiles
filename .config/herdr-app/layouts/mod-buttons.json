{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.9"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "mod-buttons-bar"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "herdr-nvim-header",
                      "props": {
                        "replaces": {
                          "mod": "pane"
                        }
                      }
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "herdr-nvim",
                        "props": {
                          "replaces": {
                            "mod": "files"
                          },
                          "panel_width_was": {
                            "px": 368
                          },
                          "panel_width": 300
                        }
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "herdr-ranch-prs",
                      "type": "block",
                      "content": {
                        "mod": "herdr-ranch-prs",
                        "props": {
                          "slot": "panel"
                        }
                      }
                    },
                    {
                      "id": "herdr-ranch-issues",
                      "type": "block",
                      "content": {
                        "mod": "herdr-ranch-issues",
                        "props": {
                          "slot": "panel"
                        }
                      }
                    },
                    {
                      "id": "herdr-ranch-reviews",
                      "type": "block",
                      "content": {
                        "mod": "herdr-ranch-reviews",
                        "props": {
                          "slot": "panel"
                        }
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 300
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status-row",
          "type": "row",
          "size": {
            "px": 28
          },
          "resizable": false,
          "children": [
            {
              "id": "status",
              "type": "block",
              "size": {
                "weight": 1
              },
              "content": {
                "mod": "workspace-status"
              }
            },
            {
              "id": "usage-limits",
              "type": "block",
              "size": {
                "weight": 2.2
              },
              "min": 130,
              "content": {
                "mod": "usage-limits"
              }
            }
          ]
        },
        {
          "id": "background-herdr-ranch-reviews",
          "type": "block",
          "content": {
            "mod": "herdr-ranch-reviews",
            "props": {
              "background": true
            }
          },
          "size": {
            "px": 0
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/mod-buttons.svg",
  "floating": [
    {
      "id": "herdr-nvim-sync",
      "content": {
        "mod": "herdr-nvim",
        "props": {
          "role": "sync"
        }
      },
      "edge": "bottom",
      "align": "end"
    }
  ]
}